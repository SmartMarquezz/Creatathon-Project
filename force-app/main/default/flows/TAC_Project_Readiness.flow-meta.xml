<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Should_Create_Task</name>
        <label>Should Create Task</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Notify</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_ShouldNotify</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Referral_Task</targetReference>
            </connector>
            <label>Yes Notify</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fx_Score</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.GitHub_Repo_URL__c}), 0, 20) + IF(ISBLANK({!$Record.Project_Summary__c}), 0, 20) + IF({!$Record.Deployed__c}, 20, 0) + IF(ISBLANK({!$Record.LinkedIn_Post_URL__c}), 0, 20) + IF({!$Record.Live_Demo_Ready__c}, 10, 0) + IF(CONTAINS(IF(ISBLANK({!Get_Talent.Certifications__c}), &quot;&quot;, {!Get_Talent.Certifications__c}), &quot;None Yet&quot;), 0, 10)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fx_Status</name>
        <dataType>String</dataType>
        <expression>IF({!fx_Score} &lt;= 40, &quot;Scouted&quot;, IF({!fx_Score} &lt;= 69, &quot;In Progress&quot;, IF({!fx_Score} &lt;= 89, &quot;Project Deployed&quot;, &quot;Job Ready&quot;)))</expression>
    </formulas>
    <formulas>
        <name>fx_ShouldNotify</name>
        <dataType>Boolean</dataType>
        <expression>AND({!fx_Score} &gt;= 70, OR(ISBLANK({!Get_Talent.Job_Readiness_Score__c}), {!Get_Talent.Job_Readiness_Score__c} &lt; 70))</expression>
    </formulas>
    <formulas>
        <name>fx_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;🚀 &quot; &amp; {!Get_Talent.Name} &amp; &quot; hit launch threshold — time to refer&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_TaskDue</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 1</expression>
    </formulas>
    <interviewLabel>TAC Project Readiness {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TAC Project Readiness</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Referral_Task</name>
        <label>Create Referral Task</label>
        <locationX>440</locationX>
        <locationY>518</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fx_TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fx_TaskDue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.TAC_Talent__c</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Talent</name>
        <label>Get Talent</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Talent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.TAC_Talent__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TAC_Talent__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Talent</name>
        <label>Update Talent</label>
        <locationX>176</locationX>
        <locationY>338</locationY>
        <connector>
            <targetReference>Should_Create_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.TAC_Talent__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Job_Readiness_Score__c</field>
            <value>
                <elementReference>fx_Score</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Launch_Status__c</field>
            <value>
                <elementReference>fx_Status</elementReference>
            </value>
        </inputAssignments>
        <object>TAC_Talent__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Talent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TAC_Talent__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>TAC_Project__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
